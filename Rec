def generate_summary_stats(matched: pd.DataFrame, breaks: pd.DataFrame,
xtp_total: int, jpm_total: int) -> Dict:
“”“Generate summary statistics for the reconciliation.”””
return {
‘Total XTP Records’: xtp_total,
‘Total JPM Records’: jpm_total,
‘Matched Records’: len(matched),
‘Breaks’: len(breaks),
‘Match Rate (%)’: round(len(matched) / max(xtp_total, jpm_total, 1) * 100, 2)
}

