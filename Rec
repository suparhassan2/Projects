def reconcile(xtp_file: str, jpm_file: str, output_file: str = ‘reconciliation_report.xlsx’):
“”“Main reconciliation function.”””

```
print("="*80)
print("POSITION RECONCILIATION: XTP vs JPM")
print("="*80)

# Load files
print("\n[1/6] Loading files...")
xtp_raw = load_file(xtp_file)
jpm_raw = load_file(jpm_file)
print(f"  ✓ XTP: {len(xtp_raw)} records loaded")
print(f"  ✓ JPM: {len(jpm_raw)} records loaded")

# Prepare data
print("\n[2/6] Preparing and standardizing data...")
xtp_prep = prepare_xtp_data(xtp_raw)
jpm_prep = prepare_jpm_data(jpm_raw)
print(f"  ✓ Data prepared and multipliers applied")

# Aggregate positions
print("\n[3/6] Aggregating positions...")
xtp_agg = aggregate_positions(xtp_prep)
jpm_agg = aggregate_positions(jpm_prep)
print(f"  ✓ XTP: {len(xtp_agg)} unique position groups")
print(f"  ✓ JPM: {len(jpm_agg)} unique position groups")

# Reconcile
print("\n[4/6] Reconciling positions...")
matched, breaks, (xtp_only, jpm_only, qty_breaks) = reconcile_positions(xtp_agg, jpm_agg)

# Generate summary
print("\n[5/6] Generating summary statistics...")
stats = generate_summary_stats(matched, breaks, len(xtp_agg), len(jpm_agg))

# Print summary
print("\n" + "="*80)
print("RECONCILIATION SUMMARY")
print("="*80)
for key, value in stats.items():
    print(f"{key:.<40} {value}")
print("\nBreakdown of Breaks:")
print(f"  • XTP Only (not in JPM):....................... {len(xtp_only)}")
print(f"  • JPM Only (not in XTP):....................... {len(jpm_only)}")
print(f"  • Quantity Mismatches:......................... {len(qty_breaks)}")

# Export results
print(f"\n[6/6] Exporting results to {output_file}...")
with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
    # Summary sheet
    summary_df = pd.DataFrame([stats])
    summary_df.to_excel(writer, sheet_name='Summary', index=False)
    
    # Matched positions
    if len(matched) > 0:
        format_output(matched, 'matched').to_excel(writer, sheet_name='Matched', index=False)
    
    # All breaks
    if len(breaks) > 0:
        format_output(breaks, 'breaks').to_excel(writer, sheet_name='All Breaks', index=False)
    
    # XTP only
    if len(xtp_only) > 0:
        format_output(xtp_only, 'xtp_only').to_excel(writer, sheet_name='XTP Only', index=False)
    
    # JPM only
    if len(jpm_only) > 0:
        format_output(jpm_only, 'jpm_only').to_excel(writer, sheet_name='JPM Only', index=False)
    
    # Quantity breaks
    if len(qty_breaks) > 0:
        format_output(qty_breaks, 'qty_breaks').to_excel(writer, sheet_name='Quantity Breaks', index=False)

print(f"  ✓ Report saved successfully")
print("\n" + "="*80)
print("RECONCILIATION COMPLETE")
print("="*80)
```

