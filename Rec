def aggregate_positions(df: pd.DataFrame) -> pd.DataFrame:
“”“Aggregate positions by matching criteria.”””
# Group by matching criteria and sum quantities
grouped = df.groupby([
‘Account’,
‘Product_Code’,
‘Adjusted_Strike’,
‘Adjusted_Settlement’
], dropna=False).agg({
‘Quantity’: ‘sum’,
‘Strike_Price’: ‘first’,
‘Settlement_Price’: ‘first’,
‘Source’: ‘first’
}).reset_index()

```
return grouped
```

def reconcile_positions(xtp_agg: pd.DataFrame, jpm_agg: pd.DataFrame) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
“”“Reconcile aggregated positions between XTP and JPM.”””

```
# Merge on matching criteria
merge_keys = ['Account', 'Product_Code', 'Adjusted_Strike', 'Adjusted_Settlement']

merged = pd.merge(
    xtp_agg, jpm_agg,
    on=merge_keys,
    how='outer',
    suffixes=('_XTP', '_JPM'),
    indicator=True
)

# Fill NaN quantities with 0
merged['Quantity_XTP'] = merged['Quantity_XTP'].fillna(0)
merged['Quantity_JPM'] = merged['Quantity_JPM'].fillna(0)

# Calculate difference
merged['Difference'] = merged['Quantity_XTP'] - merged['Quantity_JPM']

# Categorize results
matched = merged[merged['Difference'] == 0].copy()
breaks = merged[merged['Difference'] != 0].copy()

# Separate XTP-only and JPM-only
xtp_only = breaks[breaks['_merge'] == 'left_only'].copy()
jpm_only = breaks[breaks['_merge'] == 'right_only'].copy()
quantity_breaks = breaks[breaks['_merge'] == 'both'].copy()

return matched, breaks, (xtp_only, jpm_only, quantity_breaks)
```

