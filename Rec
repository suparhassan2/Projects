def load_file(filepath: str) -> pd.DataFrame:
“”“Load Excel or CSV file into DataFrame.”””
path = Path(filepath)
if not path.exists():
raise FileNotFoundError(f”File not found: {filepath}”)

```
if path.suffix.lower() in ['.xlsx', '.xls']:
    return pd.read_excel(filepath)
elif path.suffix.lower() == '.csv':
    return pd.read_csv(filepath)
else:
    raise ValueError(f"Unsupported file format: {path.suffix}")
```

def normalize_column_names(df: pd.DataFrame) -> pd.DataFrame:
“”“Normalize column names to handle variations.”””
df.columns = df.columns.str.strip()
return df

def get_product_code_xtp(row: pd.Series) -> str:
“”“Get product code from XTP file using fallback logic.”””
clearing_code = row.get(‘Clearing Code’, ‘’)
exchange_clearing_code = row.get(‘Exchange Clearing Code’, ‘’)

```
# Use Clearing Code if not blank, otherwise use Exchange Clearing Code
if pd.notna(clearing_code) and str(clearing_code).strip():
    return str(clearing_code).strip()
elif pd.notna(exchange_clearing_code) and str(exchange_clearing_code).strip():
    return str(exchange_clearing_code).strip()
else:
    return ''
```

def apply_multiplier(value: float, product_code: str, multiplier_dict: Dict[str, float], default: float) -> float:
“”“Apply product-specific multiplier to a value.”””
if pd.isna(value):
return np.nan

```
multiplier = multiplier_dict.get(product_code, default)
return float(value) * multiplier
```

def prepare_xtp_data(df: pd.DataFrame) -> pd.DataFrame:
“”“Prepare XTP data with standardized columns.”””
df = normalize_column_names(df)

```
# Create product code column
df['Product_Code'] = df.apply(get_product_code_xtp, axis=1)

# Standardize column names
required_cols = {
    'Account': ['Account', 'Account Number', 'Acct'],
    'Strike_Price': ['Strike Price', 'Strike', 'StrikePrice'],
    'Settlement_Price': ['Settlement Price', 'Settlement', 'SettlementPrice', 'Settle Price'],
    'Quantity': ['Quantity', 'Qty', 'Position']
}

result = pd.DataFrame()
result['Product_Code'] = df['Product_Code']

for std_name, possible_names in required_cols.items():
    found = False
    for col in possible_names:
        if col in df.columns:
            result[std_name] = df[col]
            found = True
            break
    if not found:
        raise ValueError(f"Could not find column for {std_name} in XTP file. Expected one of: {possible_names}")

# Apply multipliers
result['Adjusted_Strike'] = result.apply(
    lambda row: apply_multiplier(row['Strike_Price'], row['Product_Code'], 
                                 STRIKE_MULTIPLIERS, DEFAULT_STRIKE_MULTIPLIER),
    axis=1
)

result['Adjusted_Settlement'] = result.apply(
    lambda row: apply_multiplier(row['Settlement_Price'], row['Product_Code'], 
                                 SETTLEMENT_MULTIPLIERS, DEFAULT_SETTLEMENT_MULTIPLIER),
    axis=1
)

result['Source'] = 'XTP'
return result
```

