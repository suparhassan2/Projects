import holidays
import pandas as pd

year = 2026

currency_market_map = {
    "USD": "NYSE",
    "CAD": "TSX",
    "GBP": "LSE",
    "EUR": "TARGET",
    "CHF": "SIX",
    "DKK": "CSE",
    "NOK": "OSE",
    "JPY": "TSE",
    "SGD": "SGX",
    "AUD": "ASX",
    "NZD": "NZX",
}

# Build a DataFrame with one independent column per currency
df = pd.DataFrame()

for ccy, mkt in currency_market_map.items():
    fh = holidays.financial_holidays(mkt, years=[year])  # dict-like: {date: "Holiday Name"} [web:3][web:4]
    # Sort dates and convert to strings for CSV
    dates = sorted(fh.keys())
    # Represent this currency as a column of its own holiday dates
    df[ccy] = [d.isoformat() for d in dates]

# Replace NaN with empty string so CSV cells are blank rather than 'NaN' [web:32]
df = df.fillna("")

df.to_csv("fx_trading_holidays_2026_per_currency_column.csv", index=False)
print(df.head())
