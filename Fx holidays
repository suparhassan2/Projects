import holidays
import pandas as pd

year = 2026

# Map ISO currency -> financial market code used by python-holidays
# (examples; adjust to your exact venues if needed)
currency_market_map = {
    "USD": "NYSE",   # US FX/settlement broadly aligned with US financial holidays [web:3][web:15]
    "CAD": "TSX",    # Toronto Stock Exchange financial calendar
    "GBP": "LSE",    # London Stock Exchange financial calendar [web:3][web:15]
    "EUR": "TARGET", # ECB TARGET settlement calendar [web:3][web:15]
    "CHF": "SIX",    # SIX Swiss Exchange
    "DKK": "CSE",    # Copenhagen Stock Exchange
    "NOK": "OSE",    # Oslo Stock Exchange
    "JPY": "TSE",    # Tokyo Stock Exchange
    "SGD": "SGX",    # Singapore Exchange
    "AUD": "ASX",    # Australian Securities Exchange
    "NZD": "NZX",    # New Zealand Exchange
}

# Build dict: currency -> pandas.Series(index=date, value=holiday_name)
holiday_series = {}

for ccy, mkt in currency_market_map.items():
    fh = holidays.financial_holidays(mkt, years=[year])  # financial market holidays for that venue [web:3][web:14]
    # Convert to Series with date index and holiday names as values
    s = pd.Series(
        data=list(fh.values()),
        index=pd.to_datetime(list(fh.keys())),
        name=ccy
    ).sort_index()
    holiday_series[ccy] = s

# Union of all holiday dates across all currencies
all_dates = sorted(
    set().union(*[set(s.index) for s in holiday_series.values()])
)

# Build DataFrame with one column per currency
df = pd.DataFrame(index=all_dates)

for ccy, s in holiday_series.items():
    # Reindex to union of dates; keep holiday name where applicable, NaN otherwise
    df[ccy] = s.reindex(all_dates)

# Optional: make the date a normal column instead of index
df = df.reset_index().rename(columns={"index": "Date"})

# Write to CSV
df.to_csv("fx_trading_holidays_2026.csv", index=False)
print(df.head())
